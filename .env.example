# ──────────────────────────────────────────────────────────────────────────
# FinSight AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────

# ── LLM Providers (configure at least one) ────────────────────────────────
# Primary: Groq Cloud — fastest inference, free tier available
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3-32b

# Secondary fallback: OpenAI (optional but recommended for production)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tertiary fallback: Local Ollama (optional, fully offline)
# Install Ollama at: https://ollama.ai/ then run: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Provider fallback order (comma-separated)
LLM_PROVIDER_ORDER=["groq","openai","ollama"]

# ── API Security ───────────────────────────────────────────────────────────
# List of valid API keys for the REST API (change in production!)
API_KEYS=["dev-key-change-in-production"]

# ── Application ───────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Retrieval Configuration ───────────────────────────────────────────────
RETRIEVER_TOP_K=6               # Candidates retrieved before reranking
RERANKER_TOP_N=3                # Final chunks passed to LLM after reranking
HYBRID_ALPHA=0.6                # 0=pure BM25, 1=pure dense, 0.6=recommended
CHUNKING_STRATEGY=recursive     # Options: recursive | sentence | semantic

# ── Embedding & Reranker Models ───────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu            # Change to "cuda" if GPU available

# ── Storage Paths ─────────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/faiss_index
SQLITE_DB_PATH=data/finsight.db

# ── Guardrails ────────────────────────────────────────────────────────────
ENABLE_INPUT_GUARD=true
ENABLE_OUTPUT_GUARD=true
HALLUCINATION_THRESHOLD=0.3     # Flag answers with faithfulness < this value

# ── Observability (LangSmith) — Optional ──────────────────────────────────
# Get your key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finsight-ai
